# ---- Google Sheets (read-only service account) ----
# Create this in Google Cloud Console > IAM & Admin > Service Accounts.
# Share your Google Sheet with this email as "Viewer".
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key value from the downloaded JSON key file.
# Keep the \n escape sequences and the surrounding quotes exactly as shown.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The long ID in your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Tab name (and optional range), e.g. "Sheet1" or "Sheet1!A1:J"
GOOGLE_SHEET_RANGE=Sheet1

# ---- Anthropic ----
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
